{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tabspace",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-09-23",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"routes": [
		{
			"pattern": "tabspace.germon.me",
			"custom_domain": true
		}
	],
	"observability": {
		"enabled": true
	}
}
